{
  "c": {
    ".read": true,
    "$k": {
      ".write": "auth != null && $k.matches(/^(c0|c1|c2|c3|c4|c5|c6|comp)$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && !data.parent().parent().child('u/' + auth.uid + '/' + $k).exists() && newData.parent().parent().child('u/' + auth.uid + '/' + $k).exists()"
    }
  },
  "u": {
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      "$k": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && $k.matches(/^(c0|c1|c2|c3|c4|c5|c6|comp)$/) && newData.parent().parent().parent().child('c/' + $k).val() === (data.parent().parent().parent().child('c/' + $k).exists() ? data.parent().parent().parent().child('c/' + $k).val() : 0) + 1",
        ".validate": "newData.val() === now"
      }
    }
  },
  "f": {
    ".read": true,
    ".indexOn": [
      "t"
    ],
    "$uid": {
      ".write": "auth != null && auth.uid === $uid && newData.exists() && (!data.exists() || now - data.child('t').val() > 3000)",
      ".validate": "newData.hasChildren(['c', 'b', 't'])",
      "c": {
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 7"
      },
      "b": {
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000000"
      },
      "t": {
        ".validate": "newData.val() === now"
      },
      "$other": {
        ".validate": false
      }
    }
  },
  "x": {
    "$code": {
      ".read": "$code.matches(/^[A-Z2-9]{8}$/)",
      ".write": "auth != null && $code.matches(/^[A-Z2-9]{8}$/) && newData.exists() && (!data.exists() || data.child('u').val() === auth.uid)",
      ".validate": "newData.hasChildren(['u', 'b', 'w', 'g', 's', 'c', 't'])",
      "u": {
        ".validate": "newData.val() === auth.uid"
      },
      "b": {
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000000"
      },
      "w": {
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000000"
      },
      "g": {
        ".validate": "newData.isString() && newData.val().length <= 80 && newData.val().matches(/^[0-9]+(,[0-9]+){6}$/)"
      },
      "s": {
        ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().matches(/^[a-z0-9,]*$/)"
      },
      "c": {
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000000"
      },
      "t": {
        ".validate": "newData.val() === now"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
